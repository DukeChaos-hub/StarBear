# StarBear — example environment variables
# Copy to `.env` and fill in. None of these are required for the app to start.

# SQLite database file location (default: ./.starbear/starbear.sqlite)
# STARBEAR_DB=

# Master key for encrypting AI provider keys at rest.
# If unset, generated and stored at ./.starbear/master.key on first save.
# To rotate: delete the file and re-save your AI provider keys in Settings.
# 64-char hex recommended (32 bytes).
# STARBEAR_MASTER_KEY=

# Next.js dev server port
# PORT=3000
